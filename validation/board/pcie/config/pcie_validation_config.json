{
  "description": "PCIe XDMA board validation configuration for SOCS V18",
  "version": "1.0",
  "devices": {
    "h2c": "/dev/xdma0_h2c_0",
    "c2h": "/dev/xdma0_c2h_0",
    "user": ""
  },
  "address_map": {
    "control": "0x00000000",
    "control_r": "0x00010000",
    "mskf_r": "0x40000000",
    "mskf_i": "0x40400000",
    "scales": "0x40800000",
    "krn_r": "0x40880000",
    "krn_i": "0x40900000",
    "tmpImg_ddr": "0x40980000",
    "output": "0x40990000"
  },
  "limits": {
    "max_kernel_size": 17,
    "max_output_floats": 16384,
    "output_floats": 16384,
    "dma_chunk_bytes": 4194304,
    "poll_interval_seconds": 0.01,
    "timeout_seconds": 10.0
  },
  "verification": {
    "rmse_threshold": 1e-5,
    "max_abs_threshold": 1e-4,
    "relative_threshold": 0.01
  }
}
